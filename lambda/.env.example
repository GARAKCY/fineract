# Lambda environment variables — set in AWS Console > Lambda > Configuration > Environment variables

# DynamoDB table name (already created in us-east-1)
DYNAMODB_TABLE=BayPayUsers

# Bridge API key — set directly (simpler) OR via Secrets Manager below
# Option A (direct — set this):
BRIDGE_API_KEY=sk-live-REPLACE_WITH_YOUR_KEY

# Option B (Secrets Manager — leave BRIDGE_API_KEY blank and set this instead):
# SECRETS_ARN=arn:aws:secretsmanager:us-east-1:843131024562:secret:BayPayBridgeKey-xxxxxx

# Bridge base URL (do not change)
BRIDGE_BASE=https://api.bridge.xyz/v0

# AWS region
AWS_DEFAULT_REGION=us-east-1
