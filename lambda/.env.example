# Required Lambda environment variables (set these in AWS Console or SAM/CDK)

# DynamoDB table name
DYNAMODB_TABLE=BayPayUsers

# ARN of the AWS Secrets Manager secret holding the Bridge API key
# Secret value must be JSON: { "BRIDGE_API_KEY": "sk-live-..." }
SECRETS_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:BayPayBridgeKey-xxxxxx

# Bridge base URL (do not change unless using sandbox)
BRIDGE_BASE=https://api.bridge.xyz/v0

# Bridge sandbox URL (use for testing)
# BRIDGE_BASE=https://api.bridge.xyz/v0
